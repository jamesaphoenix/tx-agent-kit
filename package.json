{
  "name": "tx-agent-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:tunnel": "./scripts/dev.sh --tunnel",
    "dev:web": "turbo run dev --filter=@tx-agent-kit/web",
    "dev:api": "turbo run dev --filter=@tx-agent-kit/api",
    "dev:worker": "turbo run dev --filter=@tx-agent-kit/worker",
    "dev:mobile": "turbo run dev --filter=@tx-agent-kit/mobile",
    "dev:mobile:web": "pnpm --filter @tx-agent-kit/mobile dev:web",
    "dev:tunnel:status": "./scripts/dev-tunnel-status.sh",
    "dev:docs": "turbo run dev --filter=@tx-agent-kit/docs",
    "dev:open": "./scripts/open-dev-views.sh",
    "mobile:generate:api": "pnpm openapi:generate && pnpm --filter @tx-agent-kit/mobile generate:api",
    "build": "turbo run build",
    "build:quiet": "./scripts/build-quiet.sh",
    "env:configure": "./scripts/configure-local-env.sh",
    "openapi:generate": "pnpm --filter @tx-agent-kit/api openapi:generate",
    "agent-surfaces:generate": "tsx scripts/generate-agent-client-surfaces.ts",
    "agent-surfaces:check": "tsx scripts/generate-agent-client-surfaces.ts --check",
    "api:client:generate": "pnpm openapi:generate && pnpm --filter @tx-agent-kit/web generate:api && pnpm --filter @tx-agent-kit/mobile generate:api && pnpm --filter @tx-agent-kit/testkit generate:api",
    "docs:api:generate": "pnpm openapi:generate && tsx apps/docs/scripts/generate-api-docs.ts",
    "type-check": "turbo run type-check",
    "type-check:quiet": "./scripts/type-check-quiet.sh",
    "lint": "turbo run lint && pnpm lint:invariants && pnpm lint:ci-env && pnpm lint:shell && pnpm lint:jscpd",
    "lint:quiet": "./scripts/lint-quiet.sh",
    "lint:knip": "knip --no-progress --reporter compact --no-exit-code",
    "lint:services": "npx tsx scripts/lint/service-inventory.ts",
    "lint:services:gaps": "npx tsx scripts/lint/service-inventory.ts --gaps-only",
    "lint:services:json": "npx tsx scripts/lint/service-inventory.ts --json",
    "lint:services:prompts": "npx tsx scripts/lint/service-inventory.ts --prompts",
    "lint:product-leaks": "node ./scripts/lint/enforce-product-leak-and-secret-policy.mjs",
    "lint:knip:strict": "knip --no-progress --reporter compact",
    "lint:jscpd": "jscpd --config .jscpd.json apps/api/src packages/core/src scripts",
    "lint:invariants": "node ./scripts/lint/run-invariants.mjs",
    "lint:invariants:serial": "node ./scripts/lint/enforce-domain-invariants.mjs && node ./scripts/lint/enforce-web-client-contracts.mjs && node ./scripts/lint/enforce-route-kind-contracts.mjs && node ./scripts/lint/enforce-source-type-safety.mjs && node ./scripts/lint/enforce-compose-runtime-contracts.mjs && node ./scripts/lint/enforce-tsconfig-alignment.mjs && node ./scripts/lint/enforce-domain-event-contracts.mjs && node ./scripts/lint/enforce-enum-sync.mjs && node ./scripts/lint/enforce-no-hardcoded-test-emails.mjs && pnpm lint:product-leaks && pnpm agent-surfaces:check && node ./scripts/lint/enforce-agent-client-surface-sync.mjs && pnpm permissions:check && node ./scripts/lint/enforce-e2e-budget.mjs",
    "lint:ci-env": "node ./scripts/validate-ci-env.mjs",
    "lint:shell": "./scripts/check-shell-invariants.sh",
    "test": "turbo run test",
    "test:quiet": "./scripts/test-quiet.sh",
    "test:affected": "./scripts/test-affected.sh",
    "test:integration": "./scripts/test/run-integration.sh",
    "test:integration:quiet": "./scripts/test-integration-quiet.sh",
    "test:integration:repeat": "./scripts/test-integration-repeat.sh",
    "ci:check": "./scripts/ci/check-branch-ci.sh",
    "test:integration:live:k3s": "TESTKIT_INCLUDE_LIVE_INTEGRATION=1 RUN_LIVE_K3S_STAGING_INTEGRATION=1 pnpm test:integration --filter testkit -- packages/testkit/src/deploy-k3s-live.integration.test.ts",
    "test:integration:live:tunnel": "TESTKIT_INCLUDE_LIVE_INTEGRATION=1 RUN_LIVE_TUNNEL_INTEGRATION=1 pnpm test:integration --filter testkit -- packages/testkit/src/deploy-tunnel-live.integration.test.ts",
    "test:integration:live:tunnel:negative": "TESTKIT_INCLUDE_LIVE_INTEGRATION=1 RUN_LIVE_TUNNEL_NEGATIVE_INTEGRATION=1 LIVE_TUNNEL_MODE=dev pnpm test:integration --filter testkit -- packages/testkit/src/deploy-tunnel-live.integration.test.ts",
    "test:integration:ci-only": "INTEGRATION_INCLUDE_CI_ONLY=1 pnpm test:integration:quiet --filter testkit",
    "test:integration:full": "INTEGRATION_INCLUDE_CI_ONLY=1 pnpm test:integration:quiet",
    "test:integration:live:deploy": "pnpm test:integration:live:k3s && pnpm test:integration:live:tunnel",
    "test:boilerplate": "./scripts/test/run-boilerplate.sh",
    "test:boilerplate:quiet": "./scripts/test-boilerplate-quiet.sh",
    "test:db:pgtap": "./scripts/test/run-pgtap.sh",
    "test:ai:integration": "turbo run test:integration --filter @tx-agent-kit/ai",
    "test:infra:observability": "./scripts/test/check-observability.sh",
    "test:run-silent": "./scripts/test-run-silent.sh",
    "verify:temporal-types": "tsx ./scripts/verify-temporal-types.ts",
    "test:temporal-types": "vitest run -c scripts/vitest.config.ts",
    "test:temporal:integration": "./scripts/test/run-temporal-integration.sh",
    "test:temporal:cloud:integration": "./scripts/test/run-temporal-cloud-integration.sh",
    "test:temporal:cloud:integration:required": "TEMPORAL_CLOUD_REQUIRED=1 ./scripts/test/run-temporal-cloud-integration.sh",
    "test:temporal:cloud:integration:mtls": "RUN_TEMPORAL_CLOUD_INTEGRATION=1 RUN_TEMPORAL_MTLS_INTEGRATION=1 ./scripts/test/run-temporal-cloud-integration.sh",
    "test:dev:hot-reload": "./scripts/test/dev-hot-reload.sh",
    "mcp:prometheus": "./scripts/mcp/prometheus.sh",
    "mcp:jaeger": "./scripts/mcp/jaeger.sh",
    "mcp:context7": "./scripts/mcp/context7.sh",
    "mcp:supabase": "./scripts/mcp/supabase.sh",
    "mcp:spotlight": "./scripts/mcp/spotlight.sh",
    "tx-agent-kit:cli": "pnpm --silent --filter @tx-agent-kit/cli build && node packages/cli/dist/cli.js",
    "tx-agent-kit:mcp": "pnpm --silent --filter @tx-agent-kit/mcp build && node packages/mcp/dist/server.js",
    "langfuse:ensure-local": "./scripts/langfuse/ensure-local-bootstrap.sh",
    "playwright:auth:bootstrap": "node ./scripts/playwright/bootstrap-auth-storage-state.mjs",
    "mcp:codex-config": "./scripts/mcp/codex-config.sh",
    "monitoring:validate": "node scripts/monitoring/validate-monitoring.mjs",
    "tx": "node ./scripts/tx-cli.mjs",
    "infra:ensure": "./scripts/start-dev-services.sh",
    "infra:up": "./scripts/start-dev-services.sh",
    "infra:down": "docker compose -p tx-agent-kit down -v",
    "temporal:dev:up": "./scripts/temporal/start-dev.sh",
    "temporal:dev:down": "./scripts/temporal/stop-dev.sh",
    "temporal:dev:status": "./scripts/temporal/status.sh",
    "worktree:ports": "./scripts/worktree/derive-ports.sh",
    "db:migrate": "pnpm --filter @tx-agent-kit/db db:migrate",
    "db:schemas:generate": "pnpm --filter @tx-agent-kit/db db:schemas:generate",
    "db:schemas:apply": "pnpm --filter @tx-agent-kit/db db:schemas:apply",
    "db:trigger:new": "node ./scripts/tx-cli.mjs db:trigger:new",
    "db:test:reset": "./scripts/test/reset-test-db.sh",
    "db:studio": "pnpm --filter @tx-agent-kit/db db:studio",
    "scaffold:crud": "node ./scripts/tx-cli.mjs scaffold:crud",
    "deploy:build-images": "./scripts/deploy/build-images.sh",
    "deploy:migrate:staging": "./scripts/deploy/migrate.sh staging",
    "deploy:migrate:prod": "./scripts/deploy/migrate.sh prod",
    "deploy:staging": "./scripts/deploy/deploy-compose.sh staging",
    "deploy:prod": "./scripts/deploy/deploy-compose.sh prod",
    "deploy:k8s:mac:staging": "./scripts/deploy/deploy-k8s-mac.sh staging",
    "deploy:k8s:mac:prod": "./scripts/deploy/deploy-k8s-mac.sh prod",
    "deploy:k8s:gke": "./scripts/deploy/deploy-k8s-gke.sh",
    "deploy:k8s:status": "./scripts/deploy/k8s-status.sh",
    "deploy:k8s:rollback": "./scripts/deploy/k8s-rollback.sh",
    "deploy:k8s:verify:staging": "./scripts/deploy/ci/verify-k3s-staging.sh",
    "deploy:tunnel:reconcile": "./scripts/deploy/tunnel/reconcile.sh",
    "deploy:tunnel:check": "./scripts/deploy/tunnel/check.sh",
    "deploy:gitops:update": "./scripts/deploy/gitops/update-image-values.sh",
    "deploy:gitops:reconcile": "./scripts/deploy/gitops/reconcile.sh",
    "deploy:smoke": "./scripts/deploy/smoke-api.sh",
    "deploy:gcp:toy:bootstrap": "./scripts/deploy/gcp/bootstrap-toy-project.sh",
    "deploy:gcp:toy:teardown": "./scripts/deploy/gcp/teardown-toy-project.sh",
    "test:gcp:e2e": "./scripts/deploy/gcp/test-e2e.sh",
    "test:gcp:e2e:gke": "RUN_GKE_OTEL_DEPLOY_E2E=1 ./scripts/deploy/gcp/test-e2e.sh",
    "test:gcp:e2e:teardown": "./scripts/deploy/gcp/teardown-toy-project.sh",
    "permissions:sync": "node --import tsx scripts/permissions-sync.mjs",
    "permissions:check": "node --import tsx scripts/permissions-sync.mjs --check",
    "sync:agent-docs": "./scripts/sync-agent-docs.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@tx-agent-kit/logging": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "@types/node": "^25.6.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "eslint-plugin-unicorn": "^63.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.5.0",
    "jscpd": "^4.0.9",
    "knip": "^6.4.1",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "@grpc/grpc-js@<1.14.4": "1.14.4",
      "esbuild@>=0.17.0 <0.28.1": "0.28.1",
      "hono@<4.12.25": "4.12.25",
      "undici@>=6.0.0 <6.27.0": "6.27.0"
    },
    "patchedDependencies": {
      "@openrouter/sdk@0.9.11": "patches/@openrouter__sdk@0.9.11.patch"
    }
  }
}
