{
  "name": "@tx-agent-kit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bash -lc 'source ../../scripts/lib/source-env.sh; source_env_if_allowed ../../.env; ../../scripts/dev/kill-stale-service.sh api; exec tsx watch src/server.ts'",
    "build": "tsc -b",
    "openapi:generate": "tsx src/openapi.ts",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.96.2",
    "@effect/platform-node": "^0.107.0",
    "@temporalio/client": "^1.18.1",
    "@tx-agent-kit/auth": "workspace:*",
    "@tx-agent-kit/contracts": "workspace:*",
    "@tx-agent-kit/core": "workspace:*",
    "@tx-agent-kit/db": "workspace:*",
    "@tx-agent-kit/email": "workspace:*",
    "@tx-agent-kit/logging": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "@tx-agent-kit/redis": "workspace:*",
    "@tx-agent-kit/storage": "workspace:*",
    "@tx-agent-kit/stripe": "workspace:*",
    "effect": "^3.21.4",
    "openid-client": "^6.8.4",
    "@opentelemetry/api": "^1.9.1"
  },
  "devDependencies": {
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@tx-agent-kit/testkit": "workspace:*",
    "@tx-agent-kit/vitest-config": "workspace:*",
    "jose": "^6.2.3"
  }
}
