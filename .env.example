# Shared
NODE_ENV=development
LOG_LEVEL=debug

# API
API_PORT=4000
API_HOST=0.0.0.0
WORKTREE_PORT_OFFSET=0
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tx_agent_kit
REDIS_URL=redis://localhost:6379
# Event-driven outbox dispatcher (Postgres NOTIFY + worker loop, replaces the
# 5s poller schedule). Backstop sweep catches missed notifications; it is a
# cheap lock-free DB read so a low value is fine.
OUTBOX_BACKSTOP_INTERVAL_SECONDS=10
# LISTEN session connection. Leave blank to reuse DATABASE_URL. In prod set this
# to a DIRECT / session-mode connection (e.g. Supabase :5432), NEVER a
# transaction pooler (:6543) — LISTEN state is per-session and pooling breaks it.
OUTBOX_LISTENER_DATABASE_URL=
AUTH_SECRET=replace-with-a-long-random-secret
API_CORS_ORIGIN=http://localhost:3000
WEB_BASE_URL=http://localhost:3000

# Transactional email — centralized in api-keys (shared across projects)
RESEND_API_KEY=op://api-keys/Resend/api_key
RESEND_FROM_EMAIL=
# Example: RESEND_FROM_EMAIL="tx-agent-kit <no-reply@example.com>"
# Verifies inbound Resend webhook signatures. Leave empty in local dev.
RESEND_WEBHOOK_SECRET=

# Google OIDC login (Sign in with Google). Leave empty in local dev to disable.
GOOGLE_OIDC_ISSUER_URL=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_CALLBACK_URL=

# AI routing — centralized in api-keys (shared across projects)
OPENROUTER_API_KEY=op://api-keys/OpenRouter/api_key

# Web
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cloudflare Turnstile (bot protection on /sign-up). DISABLED in local dev:
# empty values make getTurnstileConfig() return null (no server-side check) and
# the sign-up widget not render, so local/dev-utils/Playwright flows aren't
# challenged. Staging/prod get the real key via their deploy env config.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TRY_ME_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_AGENCY_PRICE_ID=

# Cloudflare Tunnel (optional local dev)
DEV_CLOUDFLARE_TUNNEL_ENABLED=false
DEV_CLOUDFLARE_TUNNEL_LOG_FILE=.data/cloudflared/dev-tunnel.log
DEV_CLOUDFLARE_TUNNEL_LOCK_DIR=/tmp/tx-agent-kit-dev-tunnel.lock
DEV_CLOUDFLARE_TUNNEL_STALE_TIMEOUT_SECONDS=120
DEV_CLOUDFLARE_TUNNEL_MISSING_PID_GRACE_SECONDS=15
# DEV_CLOUDFLARE_TUNNEL_URL=http://127.0.0.1:4000
# DEV_CLOUDFLARE_TUNNEL_TOKEN=op://tx-agent-kit-services/dev/DEV_CLOUDFLARE_TUNNEL_TOKEN

# Docs
DOCS_PORT=3002

# Temporal
TEMPORAL_RUNTIME_MODE=cli
TEMPORAL_ADDRESS=localhost:7233
# For app containers on Docker Desktop/macOS, use host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=tx-agent-kit
TEMPORAL_API_KEY=
TEMPORAL_TLS_ENABLED=false
TEMPORAL_TLS_SERVER_NAME=
# tx-agent-kit examples:
# TEMPORAL_CLOUD_TEST_ADDRESS=europe-west3.gcp.api.temporal.io:7233
# TEMPORAL_CLOUD_TEST_NAMESPACE=tx-agent-kit-staging.kpujg
TEMPORAL_CLOUD_TEST_ADDRESS=
TEMPORAL_CLOUD_TEST_NAMESPACE=
TEMPORAL_CLOUD_TEST_API_KEY=
WORKER_INSPECT_PORT=9229

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4320
OTEL_LOGS_EXPORTER=otlp
# Metric export cadence (ms) for the app and client OTLP metric readers. 30s
# keeps Google Managed Prometheus ingestion (and its cost) low while staying
# inside every alert window; drop to 5000 locally for snappier dashboards.
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
LANGFUSE_ENABLED=true
LANGFUSE_BASE_URL=http://localhost:3003
LANGFUSE_HOST=http://localhost:3003
LANGFUSE_PUBLIC_KEY=pk-lf-00000000-0000-4000-8000-000000000000
LANGFUSE_SECRET_KEY=sk-lf-00000000-0000-4000-8000-000000000000
LANGFUSE_SAMPLE_RATE=1
LANGFUSE_LOG_LEVEL=WARN
# Optional Sentry error reporting (errors only; tracing disabled)
NEXT_PUBLIC_SENTRY_DSN=
API_SENTRY_DSN=
WORKER_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Sentry Spotlight (local dev observability — errors, traces, logs in desktop app)
# Set to "true" to enable. Requires the spotlight Docker service (port 8969).
# When enabled without a DSN, a local placeholder DSN is used automatically.
SENTRY_SPOTLIGHT=true

# MCP - Prometheus
# Prometheus MCP runs in Docker; this host alias reaches your host stack.
PROMETHEUS_URL=http://host.docker.internal:9090
# Optional: pin/override image tag.
# PROMETHEUS_MCP_IMAGE=ghcr.io/pab1it0/prometheus-mcp-server:latest

# MCP - Jaeger
JAEGER_URL=http://localhost
JAEGER_PROTOCOL=HTTP
JAEGER_PORT=16686

# MCP - Context7
CONTEXT7_TRANSPORT=stdio
# CONTEXT7_API_KEY=
# CONTEXT7_PORT=3000

# MCP - Supabase
SUPABASE_MCP_READ_ONLY=true
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
# SUPABASE_API_URL=https://api.supabase.com
# SUPABASE_MCP_FEATURES=database,docs,development

# MCP - Spotlight (Sentry local dev)
SPOTLIGHT_PORT=8969

# Cloudflare R2 Storage
# Local dev/test uses in-memory storage unless a real bucket is configured.
TX_STORAGE_MODE=memory
# Generate a local .env via: op inject -i .env.example -o .env
# R2_ENDPOINT is derived from R2_ACCOUNT_ID when unset (https://<account>.r2.cloudflarestorage.com).
# R2 IAM credentials are bucket-scoped; keep local/staging/prod values in
# 1Password and point them at a tx-agent-kit-owned bucket.
R2_ACCOUNT_ID=op://api-keys/Cloudflare/account_id
R2_ACCESS_KEY_ID=op://understanding-data/dev/R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=op://understanding-data/dev/R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME=tx-agent-kit-dev
R2_ENDPOINT=

# MCP - Playwright
PLAYWRIGHT_MCP_HEADLESS=true
PLAYWRIGHT_MCP_ISOLATED=true
# PLAYWRIGHT_MCP_BROWSER=chrome
# PLAYWRIGHT_MCP_CAPS=vision,pdf,devtools
# PLAYWRIGHT_MCP_OUTPUT_DIR=.artifacts/playwright-mcp
# PLAYWRIGHT_MCP_STORAGE_STATE=.artifacts/playwright-mcp/storage-state.json
# PLAYWRIGHT_AUTH_EMAIL=op://tx-agent-kit-services/dev/PLAYWRIGHT_AUTH_EMAIL
# PLAYWRIGHT_AUTH_PASSWORD=op://tx-agent-kit-services/dev/PLAYWRIGHT_AUTH_PASSWORD
# PLAYWRIGHT_AUTH_NAME=op://tx-agent-kit-services/dev/PLAYWRIGHT_AUTH_NAME
# PLAYWRIGHT_AUTH_SITE_URL=http://localhost:3000
# PLAYWRIGHT_AUTH_API_BASE_URL=http://localhost:4000
# PLAYWRIGHT_AUTH_ALLOW_PROD=false
