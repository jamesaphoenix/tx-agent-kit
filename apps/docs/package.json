  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "postcss": "8.5.14",
    "postcss-load-config": "6.0.1",
