# 1Password Vault Configuration
# Set these to your 1Password vault and environment names
# e.g., OP_VAULT=tx-agent-kit-services OP_ENV=prod
OP_VAULT=<vault>
OP_ENV=<environment>

NODE_ENV=production
LOG_LEVEL=warn
API_PORT=4000
API_HOST=0.0.0.0
DATABASE_URL=op://${OP_VAULT}/${OP_ENV}/DATABASE_URL
REDIS_URL=op://${OP_VAULT}/${OP_ENV}/REDIS_URL
# Direct/session-mode connection for the outbox LISTEN session. Leave blank to
# reuse DATABASE_URL; never point this at a transaction pooler.
OUTBOX_LISTENER_DATABASE_URL=
# Backstop sweep interval (seconds) for the event-driven outbox dispatcher.
OUTBOX_BACKSTOP_INTERVAL_SECONDS=10
AUTH_SECRET=op://${OP_VAULT}/${OP_ENV}/AUTH_SECRET
# Shared secret that lets the deploy smoke test bypass the auth rate limiter
# (x-auth-rate-limit-bypass header). Generate a long random value, e.g.
# `openssl rand -hex 32`, and store it as this 1Password field.
AUTH_RATE_LIMIT_BYPASS_TOKEN=op://${OP_VAULT}/${OP_ENV}/AUTH_RATE_LIMIT_BYPASS_TOKEN
API_CORS_ORIGIN=op://${OP_VAULT}/${OP_ENV}/API_CORS_ORIGIN
API_EXTERNAL_BASE_URL=op://${OP_VAULT}/${OP_ENV}/API_EXTERNAL_BASE_URL
WEB_BASE_URL=op://${OP_VAULT}/${OP_ENV}/WEB_BASE_URL
RESEND_API_KEY=op://${OP_VAULT}/${OP_ENV}/RESEND_API_KEY
RESEND_FROM_EMAIL=op://${OP_VAULT}/${OP_ENV}/RESEND_FROM_EMAIL
RESEND_WEBHOOK_SECRET=op://${OP_VAULT}/${OP_ENV}/RESEND_WEBHOOK_SECRET
# Auto-fix new-issue webhook (presence-gated): HMAC secret + the deployment env
# this API gates auto-fix webhooks for. Omit the secret to disable the receiver.
SENTRY_WEBHOOK_SECRET=op://${OP_VAULT}/${OP_ENV}/SENTRY_WEBHOOK_SECRET
SENTRY_DEPLOYMENT_ENVIRONMENT=production
# Bot protection on /sign-up (Cloudflare Turnstile). Secret key only; the verify
# URL has a code default.
TURNSTILE_SECRET_KEY=op://${OP_VAULT}/${OP_ENV}/TURNSTILE_SECRET_KEY
# AI routing via OpenRouter (base URL / model have code defaults).
OPENROUTER_API_KEY=op://${OP_VAULT}/${OP_ENV}/OPENROUTER_API_KEY
# Stripe billing.
STRIPE_SECRET_KEY=op://${OP_VAULT}/${OP_ENV}/STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=op://${OP_VAULT}/${OP_ENV}/STRIPE_WEBHOOK_SECRET
# Google OIDC login (Sign in with Google).
GOOGLE_OIDC_ISSUER_URL=op://${OP_VAULT}/${OP_ENV}/GOOGLE_OIDC_ISSUER_URL
GOOGLE_OIDC_CLIENT_ID=op://${OP_VAULT}/${OP_ENV}/GOOGLE_OIDC_CLIENT_ID
GOOGLE_OIDC_CLIENT_SECRET=op://${OP_VAULT}/${OP_ENV}/GOOGLE_OIDC_CLIENT_SECRET
GOOGLE_OIDC_CALLBACK_URL=op://${OP_VAULT}/${OP_ENV}/GOOGLE_OIDC_CALLBACK_URL
TEMPORAL_RUNTIME_MODE=cloud
TEMPORAL_ADDRESS=op://${OP_VAULT}/${OP_ENV}/TEMPORAL_ADDRESS
TEMPORAL_NAMESPACE=op://${OP_VAULT}/${OP_ENV}/TEMPORAL_NAMESPACE
TEMPORAL_TASK_QUEUE=op://${OP_VAULT}/${OP_ENV}/TEMPORAL_TASK_QUEUE
TEMPORAL_API_KEY=op://${OP_VAULT}/${OP_ENV}/TEMPORAL_API_KEY
TEMPORAL_TLS_ENABLED=true
TEMPORAL_TLS_SERVER_NAME=
# Optional Temporal TLS PEM material (for namespace-specific cert auth)
# TEMPORAL_TLS_CA_CERT_PEM=<set via runtime env or vault field TEMPORAL_TLS_CA_CERT_PEM>
# TEMPORAL_TLS_CLIENT_CERT_PEM=<set via runtime env or vault field TEMPORAL_TLS_CLIENT_CERT_PEM>
# TEMPORAL_TLS_CLIENT_KEY_PEM=<set via runtime env or vault field TEMPORAL_TLS_CLIENT_KEY_PEM>
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_LOGS_EXPORTER=otlp
# Metric export cadence (ms) for app/client OTLP readers. 30s keeps Google
# Managed Prometheus ingestion cost low (unified across local/staging/prod).
OTEL_METRIC_EXPORT_INTERVAL_MS=30000
LANGFUSE_ENABLED=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_ENABLED
LANGFUSE_BASE_URL=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_BASE_URL
LANGFUSE_HOST=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_HOST
LANGFUSE_PUBLIC_KEY=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_SECRET_KEY
LANGFUSE_SAMPLE_RATE=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_SAMPLE_RATE
LANGFUSE_LOG_LEVEL=op://${OP_VAULT}/${OP_ENV}/LANGFUSE_LOG_LEVEL
# Optional Sentry error reporting for worker (errors only; tracing disabled)
# WORKER_SENTRY_DSN=<set via runtime env or vault field WORKER_SENTRY_DSN>
OTEL_COLLECTOR_BACKEND=gcp
OTEL_SERVICE_NAMESPACE=<service_namespace>
GOOGLE_CLOUD_PROJECT=op://${OP_VAULT}/${OP_ENV}/GOOGLE_CLOUD_PROJECT
GOOGLE_APPLICATION_CREDENTIALS=
OTEL_COLLECTOR_GCP_CREDENTIALS_DIR=./deploy/gcp-empty
OTEL_COLLECTOR_GCLOUD_CONFIG_DIR=./deploy/gcloud-empty
OTEL_JAEGER_ENDPOINT=http://jaeger:4318
OTEL_PROMETHEUS_OTLP_ENDPOINT=http://prometheus:9090/api/v1/otlp
OTEL_LOKI_OTLP_ENDPOINT=http://loki:3100/otlp
# Optional Cloudflare tunnel settings (k8s and compose deploys)
# Compose deploys: upstream defaults to http://127.0.0.1:4000 (the mapped API port).
# K8s deploys: upstream defaults to 32080/32081 (NodePort).
# Enable in compose via RUN_TUNNEL_RECONCILE=1 (opt-in). K8s defaults to on.
# CLOUDFLARE_TUNNEL_ID=<set via workflow secret CLOUDFLARE_TUNNEL_ID>
# CLOUDFLARE_TUNNEL_CREDENTIALS_FILE=<set via workflow secret CLOUDFLARE_TUNNEL_CREDENTIALS_FILE>
# CLOUDFLARE_TUNNEL_HOST_DEV=<set via workflow secret CLOUDFLARE_TUNNEL_HOST_DEV>
# CLOUDFLARE_TUNNEL_HOST_STAGING=<set via workflow secret CLOUDFLARE_TUNNEL_HOST_STAGING>
# CLOUDFLARE_TUNNEL_HOST_PROD=<set via workflow secret CLOUDFLARE_TUNNEL_HOST_PROD>
# CLOUDFLARE_TUNNEL_UPSTREAM_DEV=http://127.0.0.1:4000
