{
  "name": "@tx-agent-kit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bash -lc 'source ../../scripts/lib/source-env.sh; source_env_if_allowed ../../.env; ../../scripts/dev/kill-stale-service.sh worker; exec node --inspect=${WORKER_INSPECT_PORT:-9229} ../../node_modules/tsx/dist/cli.mjs watch src/index.ts'",
    "build": "tsc -b",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:temporal": "vitest run -c vitest.temporal.integration.config.ts"
  },
  "dependencies": {
    "@temporalio/activity": "^1.18.1",
    "@temporalio/client": "^1.18.1",
    "@temporalio/common": "^1.18.1",
    "@temporalio/worker": "^1.18.1",
    "@temporalio/workflow": "^1.18.1",
    "@tx-agent-kit/contracts": "workspace:*",
    "@tx-agent-kit/core": "workspace:*",
    "@tx-agent-kit/db": "workspace:*",
    "@tx-agent-kit/email": "workspace:*",
    "@tx-agent-kit/logging": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "@tx-agent-kit/redis": "workspace:*",
    "@tx-agent-kit/storage": "workspace:*",
    "@tx-agent-kit/stripe": "workspace:*",
    "effect": "^3.21.4",
    "pg": "^8.22.0",
    "sharp": "^0.35.2"
  },
  "devDependencies": {
    "@tx-agent-kit/testkit": "workspace:*",
    "@tx-agent-kit/vitest-config": "workspace:*",
    "@types/pg": "^8.20.0"
  }
}
