<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.tx-agent-kit.auto-fix-runner</string>

  <!--
    Generic template. Run via a login shell so PATH (codex/claude/gh/op, pnpm,
    node) and the shared shell config are available. Replace __PROJECT_DIR__
    with the absolute repo root on the single host worker when installing.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>cd __PROJECT_DIR__; source ~/.zshrc &gt;/dev/null 2&gt;&amp;1; AUTO_FIX_ENABLED=true scripts/auto-fix-runner.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Keep the host worker alive; launchd restarts it if it exits. -->
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/.logs/auto-fix-runner.out.log</string>

  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/.logs/auto-fix-runner.err.log</string>
</dict>
</plist>
