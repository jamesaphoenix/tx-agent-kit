{
  "name": "@tx-agent-kit/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "bash -lc 'set -a; [[ -f ../../.env ]] && source ../../.env; set +a; export NODE_OPTIONS=\"--inspect=${WORKER_INSPECT_PORT:-9229}\"; lsof -ti :${WORKER_INSPECT_PORT:-9229} | xargs kill -9 2>/dev/null; exec tsx watch src/index.ts'",
    "build": "tsc -b",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:integration:temporal": "vitest run -c vitest.temporal.integration.config.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.50.0",
    "@temporalio/client": "^1.16.1",
    "@temporalio/common": "^1.16.1",
    "@temporalio/worker": "^1.16.1",
    "@temporalio/workflow": "^1.16.1",
    "@tx-agent-kit/contracts": "workspace:*",
    "@tx-agent-kit/core": "workspace:*",
    "@tx-agent-kit/db": "workspace:*",
    "@tx-agent-kit/email": "workspace:*",
    "@tx-agent-kit/logging": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "@tx-agent-kit/storage": "workspace:*",
    "@tx-agent-kit/stripe": "workspace:*",
    "effect": "^3.21.2",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@tx-agent-kit/testkit": "workspace:*",
    "@tx-agent-kit/vitest-config": "workspace:*"
  }
}
