{
  "name": "@tx-agent-kit/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./constants.js": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    },
    "./literals": {
      "types": "./dist/literals.d.ts",
      "import": "./dist/literals.js"
    },
    "./literals.js": {
      "types": "./dist/literals.d.ts",
      "import": "./dist/literals.js"
    },
    "./agent-client-surface": {
      "types": "./dist/agent-client-surface.d.ts",
      "import": "./dist/agent-client-surface.js"
    },
    "./agent-client-surface.js": {
      "types": "./dist/agent-client-surface.d.ts",
      "import": "./dist/agent-client-surface.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run -c vitest.config.ts"
  },
  "dependencies": {
    "effect": "^3.21.2"
  },
  "devDependencies": {
    "@tx-agent-kit/vitest-config": "workspace:*",
    "fast-check": "^4.8.0"
  }
}
