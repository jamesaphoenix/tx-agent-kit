{
  "name": "@tx-agent-kit/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "lsof -ti :${WEB_PORT:-${PORT:-3000}} | xargs kill -9 2>/dev/null; next dev --webpack -p ${WEB_PORT:-${PORT:-3000}}",
    "build": "next build",
    "start": "next start -p ${WEB_PORT:-${PORT:-3000}}",
    "generate:api": "orval --config ./orval.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "test:integration": "vitest run -c vitest.integration.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^7.3.9",
    "@sentry/browser": "^10.53.1",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-devtools": "^5.100.11",
    "@tanstack/react-store": "^0.11.0",
    "@tx-agent-kit/contracts": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.39.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "nuqs": "^2.8.9",
    "react": "19.2.6",
    "react-admin": "^5.14.7",
    "react-dom": "19.2.6",
    "react-select": "^5.10.2",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tx-agent-kit/testkit": "workspace:*",
    "@tx-agent-kit/vitest-config": "workspace:*",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "jsdom": "^29.0.2",
    "orval": "^8.8.0",
    "postcss": "8.5.10",
    "tailwindcss": "^4.2.2"
  }
}
