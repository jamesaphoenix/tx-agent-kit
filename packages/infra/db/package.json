{
  "name": "@tx-agent-kit/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "type-check": "tsc -b --pretty false",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run -c vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm exec tsx ./scripts/migrate.ts",
    "db:schemas:generate": "pnpm exec tsx ./scripts/generate-schemas.ts",
    "db:schemas:apply": "pnpm exec tsx ./scripts/apply-schemas.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@effect/experimental": "^0.59.0",
    "@effect/platform": "^0.95.0",
    "@effect/sql": "^0.50.0",
    "@effect/sql-pg": "^0.51.0",
    "@tx-agent-kit/contracts": "workspace:*",
    "drizzle-orm": "^1.0.0-beta.9",
    "effect": "^3.20.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@tx-agent-kit/vitest-config": "workspace:*",
    "@types/pg": "^8.18.0",
    "drizzle-kit": "^1.0.0-beta.9"
  }
}
