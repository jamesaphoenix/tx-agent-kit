{
  "name": "@tx-agent-kit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'expo start --port ${MOBILE_PORT:-8081}'",
    "dev:web": "sh -c 'expo start --web --port ${MOBILE_PORT:-8081}'",
    "generate:api": "orval --config ./orval.config.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@sentry/react-native": "^8.15.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-store": "^0.11.0",
    "@tx-agent-kit/contracts": "workspace:*",
    "@tx-agent-kit/observability": "workspace:*",
    "axios": "^1.18.0",
    "expo": "~53.0.27",
    "expo-constants": "~17.1.8",
    "expo-router": "~4.0.22",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~2.2.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-native": "0.85.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.24.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@tx-agent-kit/testkit": "workspace:*",
    "@tx-agent-kit/vitest-config": "workspace:*",
    "@types/react": "^19.2.17",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~13.2.5",
    "orval": "^8.18.0",
    "react-test-renderer": "19.2.5",
    "typescript": "^5.9.3"
  }
}
