# .env.tunnel - tunnel-mode overlay (committed; op:// references only).
#
# `pnpm dev --tunnel` (alias `pnpm dev:tunnel`) sources this file AFTER .env so
# its values win, then keeps it applied across per-app dev scripts via the
# .data/dev-env-overlay marker + turbo globalPassThroughEnv=TX_DEV_ENV_OVERLAY.
# Plain `pnpm dev` never reads this file.
#
# This overlay only flips the existing Cloudflare-tunnel plumbing on and points
# at the 1Password-backed token. NEVER put plaintext secrets here - only op://
# references resolved at source time by the 1Password CLI.
DEV_CLOUDFLARE_TUNNEL_ENABLED=true
DEV_CLOUDFLARE_TUNNEL_TOKEN=op://tx-agent-kit-services/dev/DEV_CLOUDFLARE_TUNNEL_TOKEN
